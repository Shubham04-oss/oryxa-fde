// Oryxa SpiceDB schema v1. Every object id is "<tenant>|<id>" (see oryxa-authz ids.rs),
// so tenants never share objects; the workspace object is the tenant root.
use expiration

definition user {}

definition workspace {
    relation admin: user
    relation member: user

    permission manage = admin
    permission access = admin + member
}

definition team {
    relation workspace: workspace
    relation member: user
}

// Personal agent: owner set. Workspace agent: operators set, owner empty.
definition agent {
    relation workspace: workspace
    relation owner: user
    relation operator: user | team#member

    permission act_for = owner + operator
    permission configure = owner + workspace->manage
}

// Approval bound to one exact call: the grant only holds when the request's args hash matches.
caveat args_match(approved_args_hash string, args_hash string) {
    approved_args_hash == args_hash
}

definition capability {
    relation agent: agent
    relation invoker: user | team#member | workspace#member
    relation approved_invoker: user with args_match and expiration
    relation blocked: user

    permission invoke = (invoker + approved_invoker) - blocked
    // Fed to the Cedar guardrails as context.approved.
    permission approved = approved_invoker - blocked
    permission grant = agent->configure
}

// A provider connection held by the credential broker. Egress handles are issued only after
// `use` for the acting agent (or, in the UI, the human owner).
definition connection {
    relation workspace: workspace
    // Personal connection: its owner. Workspace connection: the admin who connected it.
    relation owner: user
    // Agents allowed to act through it. For a personal connection the broker writes the owner's
    // personal agent here (and still checks acting_for == owner); for a workspace connection, the
    // agents an admin granted.
    relation agent_user: agent

    // The owner grants only while still in the workspace: removal cuts access at once.
    permission use = (owner & workspace->access) + agent_user
    permission manage = (owner & workspace->access) + workspace->manage
}
