// Oryxa SpiceDB schema v1. Every object id is "<tenant>|<id>" (see oryxa-authz ids.rs),
// so tenants never share objects; the workspace object is the tenant root.
use expiration

definition user {}

definition workspace {
    relation admin: user
    relation member: user

    permission manage = admin
    permission access = admin + member
}

definition team {
    relation workspace: workspace
    relation member: user
}

// Personal agent: owner set. Workspace agent: operators set, owner empty.
definition agent {
    relation workspace: workspace
    relation owner: user
    relation operator: user | team#member

    permission act_for = owner + operator
    permission configure = owner + workspace->manage
}

// Approval bound to one exact call: the grant only holds when the request's args hash matches.
caveat args_match(approved_args_hash string, args_hash string) {
    approved_args_hash == args_hash
}

definition capability {
    relation agent: agent
    relation invoker: user | team#member | workspace#member
    relation approved_invoker: user with args_match and expiration
    relation blocked: user

    permission invoke = (invoker + approved_invoker) - blocked
    // Fed to the Cedar guardrails as context.approved.
    permission approved = approved_invoker - blocked
    permission grant = agent->configure
}

definition knowledge_base {
    relation workspace: workspace
    permission query = workspace->access
}

// A data source inside a tenant KB. Native sources are checked here; Bedrock checks per doc.
// agent_reader scopes what the workspace agent may search on anyone's behalf.
definition kb_source {
    relation knowledge_base: knowledge_base
    relation viewer: user | team#member | workspace#member
    relation agent_reader: agent

    permission search = viewer & knowledge_base->query
    permission agent_search = agent_reader
}

// A group from a connected provider (Google group, Jira group or project role, Slack user group).
// Connectors flatten nesting before they sync it (Drive includeDerivedMembership, Jira group
// members), so members are users only, never other groups. ACL sync (#30) keeps it current and
// writes a removal as a delete at once, never waiting for a later full resync.
definition provider_group {
    relation workspace: workspace
    relation member: user
}

// Documents from Oryxa's own connectors; we are the ACL source, so check per doc.
// workspace#member is granted only for shares to the tenant's verified WorkOS domains; link-only
// sharing and people we cannot match to an Oryxa user grant nothing.
definition kb_item {
    relation source: kb_source
    relation viewer: user | team#member | provider_group#member | workspace#member
    relation owner: user

    permission view = (viewer + owner) & source->search
    // An agent sees an item only through a source it was explicitly given. The full rule for an
    // agent (also what its human and every reader of the answer can see) is oryxa-authz kb_visible.
    permission agent_view = source->agent_search
}

// A provider connection held by the credential broker. Egress handles are issued only after
// `use` for the acting agent (or, in the UI, the human owner).
definition connection {
    relation workspace: workspace
    // Personal connection: its owner. Workspace connection: the admin who connected it.
    relation owner: user
    // Agents allowed to act through it. For a personal connection the broker writes the owner's
    // personal agent here (and still checks acting_for == owner); for a workspace connection, the
    // agents an admin granted.
    relation agent_user: agent

    // The owner grants only while still in the workspace: removal cuts access before #30's cleanup.
    permission use = (owner & workspace->access) + agent_user
    permission manage = (owner & workspace->access) + workspace->manage
}
