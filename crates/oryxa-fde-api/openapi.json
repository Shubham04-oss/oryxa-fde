{
  "openapi": "3.1.0",
  "info": {
    "title": "oryxa-fde-api",
    "description": "The FDE workspace API.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Finish sign-in: sets the session cookie and redirects to where sign-in started.",
        "operationId": "sign_in_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in, to the page sign-in started from; or refused because the person is in no WorkOS organisation, to `/sign-in?error=no_organisation` with no session"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/invitation": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "The invitation a link's token names: its address, organisation and whether the address has an\naccount, for the accept screen. A token that names no open invitation is 400 `invalid_invitation`.",
        "operationId": "look_up_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationOut"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_invitation`: unknown, accepted, expired or revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/invitation/accept": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Accept an invitation and sign in. The address is the invitation's own: a new account gets this\npassword and name, and an existing one signs in with its own password.",
        "operationId": "accept_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (`done`, with the session cookie), or the next step, with a short-lived pending cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_invitation`; `weak_password`: the password does not meet the policy; `invalid_password`, `invalid_name`, `invalid_return_to`, `invalid_body`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`: the existing account's password is wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`; `no_organisation`; `sign_in_unsupported`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start sign-in: redirects to WorkOS AuthKit.",
        "operationId": "sign_in",
        "parameters": [
          {
            "name": "return_to",
            "in": "query",
            "description": "Where to go after sign-in: a path on the web app, e.g. `/companies`. Defaults to `/`, as\ndoes a value that is not one path on the web app.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "To WorkOS AuthKit"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out: clears the session cookie, always, and ends the WorkOS session if WorkOS answers.\nIt never refreshes or reissues the cookie, whatever state the session is in.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Signed out; the cookie is cleared"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/auth/password/forgot": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email a password reset link. The answer is the same whether or not the address has an account.",
        "operationId": "forgot_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`check_email`, whether or not a link was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetRequested"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/password/reset": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Set a new password with the token from a reset link. It signs nobody in: the account's existing\nsessions are revoked and end at their next refresh, and the person signs in with the new password.",
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`sign_in`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordChanged"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_reset_token`: wrong, spent or expired; `weak_password`; `invalid_password`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/code": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email a one-time sign-in code. The answer is the same whether or not the address has an account;\na limit reached is 429 `too_many_attempts`, alike for every address.",
        "operationId": "sign_in_request_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`enter_code`, whether or not a code was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRequested"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/code/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with the one-time code we emailed. A wrong code and an address with no account get the\nsame 401 `invalid_code`.",
        "operationId": "sign_in_with_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeSignInIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (`done`, with the session cookie), or the next step, with a short-lived pending cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`; `no_organisation`; `sign_in_unsupported`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/organisation": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Continue a sign-in into one of the organisations the last step offered.",
        "operationId": "sign_in_choose_organisation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChooseOrganisationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_sign_in`: no pending choice (start again); `invalid_organisation`: not one offered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with an email address and password. A wrong password and an unknown address get the\nsame 401 `invalid_credentials`; a limit reached gets 429 `too_many_attempts` with `Retry-After`,\nalike for every address.",
        "operationId": "sign_in_with_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSignInIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (`done`, with the session cookie), or the next step, with a short-lived pending cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`; `no_organisation` (the person is in no organisation: show the page for it, no session is set); `sign_in_unsupported`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/verify-email": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Continue a sign-in that waits on email verification, with the code we emailed.",
        "operationId": "sign_in_verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_sign_in`: no pending verification (start again); `invalid_code`: not a code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_code`: wrong or expired; the step stays open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/auth/sign-in/verify-email/resend": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email the code of a pending email verification again. The step stays as it is.",
        "operationId": "sign_in_resend_verification",
        "responses": {
          "200": {
            "description": "`verify_email`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInStep"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_sign_in`: no pending verification (start again)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`; see `Retry-After`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Who is signed in.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptInvitationIn": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "A new password, or the account's own when the address already has one."
          },
          "return_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where to go once signed in: a path on the web app. Defaults to `/`."
          },
          "token": {
            "type": "string",
            "description": "The token from the invitation link."
          }
        },
        "additionalProperties": false
      },
      "ChooseOrganisationIn": {
        "type": "object",
        "required": [
          "organisation"
        ],
        "properties": {
          "organisation": {
            "type": "string",
            "description": "One of the organisations the last step offered."
          }
        },
        "additionalProperties": false
      },
      "CodeRequestIn": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CodeRequested": {
        "type": "object",
        "description": "The one answer to asking for a sign-in code: `{\"next\":\"enter_code\"}`, whether or not the address\nhas an account. A type of its own, so no other route can claim it.",
        "required": [
          "next"
        ],
        "properties": {
          "next": {
            "$ref": "#/components/schemas/CodeRequestedNext"
          }
        }
      },
      "CodeRequestedNext": {
        "type": "string",
        "description": "If the address has an account, a code is on its way; post it to `/auth/sign-in/code/verify`.",
        "enum": [
          "enter_code"
        ]
      },
      "CodeSignInIn": {
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The one-time code we emailed to the address."
          },
          "email": {
            "type": "string"
          },
          "return_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where to go once signed in: a path on the web app. Defaults to `/`."
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A short machine-readable code, e.g. `forbidden`."
          }
        }
      },
      "ForgotPasswordIn": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "InvitationIn": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the invitation link."
          }
        },
        "additionalProperties": false
      },
      "InvitationOut": {
        "type": "object",
        "description": "An open invitation, for its screen. Only the link's holder learns it.",
        "required": [
          "email",
          "has_account"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The address it was sent to; the only one that can accept it."
          },
          "has_account": {
            "type": "boolean",
            "description": "The address has an account already: accepting takes its password, and names are ignored."
          },
          "organisation": {
            "type": [
              "string",
              "null"
            ],
            "description": "The organisation's name, when it could be read."
          }
        }
      },
      "MeOut": {
        "type": "object",
        "required": [
          "user",
          "organisation",
          "role"
        ],
        "properties": {
          "organisation": {
            "$ref": "#/components/schemas/NamedOut"
          },
          "role": {
            "$ref": "#/components/schemas/OrgRole",
            "description": "The caller's WorkOS role in the organisation."
          },
          "user": {
            "$ref": "#/components/schemas/NamedOut"
          }
        }
      },
      "NamedOut": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "OrgRole": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "OrganisationOut": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PasswordChanged": {
        "type": "object",
        "description": "The answer to a new password set: `{\"next\":\"sign_in\"}`. The account's existing sessions are\nrevoked and end at their next refresh; the person signs in with the new password.",
        "required": [
          "next"
        ],
        "properties": {
          "next": {
            "$ref": "#/components/schemas/PasswordChangedNext"
          }
        }
      },
      "PasswordChangedNext": {
        "type": "string",
        "description": "Sign in with the new password.",
        "enum": [
          "sign_in"
        ]
      },
      "PasswordSignInIn": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "return_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where to go once signed in: a path on the web app. Defaults to `/`."
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordIn": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password"
          },
          "token": {
            "type": "string",
            "description": "The token from the reset link."
          }
        },
        "additionalProperties": false
      },
      "ResetRequested": {
        "type": "object",
        "description": "The one answer to a forgotten password: `{\"next\":\"check_email\"}`, whether or not the address\nhas an account.",
        "required": [
          "next"
        ],
        "properties": {
          "next": {
            "$ref": "#/components/schemas/ResetRequestedNext"
          }
        }
      },
      "ResetRequestedNext": {
        "type": "string",
        "description": "If the address has an account, a reset link is on its way.",
        "enum": [
          "check_email"
        ]
      },
      "SignInStep": {
        "oneOf": [
          {
            "type": "object",
            "description": "Signed in: the session cookie is set. Go to `return_to`.",
            "required": [
              "return_to",
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "enum": [
                  "done"
                ]
              },
              "return_to": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "A code was emailed to the address; post it to `/auth/sign-in/verify-email`.",
            "required": [
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "enum": [
                  "verify_email"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Post one of these to `/auth/sign-in/organisation`.",
            "required": [
              "organisations",
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "enum": [
                  "choose_organisation"
                ]
              },
              "organisations": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrganisationOut"
                }
              }
            }
          }
        ],
        "description": "Where a sign-in stands after a step that worked."
      },
      "VerifyEmailIn": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code we emailed to the address."
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "WorkOS access token"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fde_session",
        "description": "The browser session from /auth/callback. A request carrying it, and no bearer token, that is not GET or HEAD must also send `X-Oryxa-Request: 1` and the web app's `Origin`, or it gets 403 {\"error\":\"csrf\"}. While WorkOS cannot refresh an expired session, any request may get 503 {\"error\":\"unavailable\"}: the cookie is kept, and the same request works once WorkOS answers."
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "session": []
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Browser sign-in, the session cookie and who is signed in"
    }
  ]
}
