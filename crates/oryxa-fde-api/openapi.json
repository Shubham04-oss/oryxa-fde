  "components": {
    "schemas": {
      "AssigneeOut": {
        "type": "object",
        "required": [
          "user",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "string"
          },
          "user": {
            "type": "string",
            "description": "WorkOS user id."
          }
        }
      },
      "CompanyOut": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A short machine-readable code, e.g. `forbidden`."
          }
        }
      },
      "MemberIn": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/MemberRole"
          }
        },
        "additionalProperties": false
      },
      "MemberOut": {
        "type": "object",
        "required": [
          "user",
          "role",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "user": {
            "type": "string",
            "description": "WorkOS user id."
          }
        }
      },
      "MemberRole": {
        "type": "string",
        "enum": [
          "lead",
          "engineer"
        ]
      },
      "NameIn": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "1 to 200 characters, no control characters."
          }
        },
        "additionalProperties": false
      },
      "ProjectOut": {
        "type": "object",
        "required": [
          "id",
          "company",
          "name",
          "stage",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "company": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/ProjectStage"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "ProjectStage": {
        "type": "string",
        "enum": [
          "discover",
          "scope",
          "access",
          "build",
          "evaluate",
          "deploy",
          "handoff",
          "operate"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "WorkOS access token"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
