                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/agent-runs/{run}/approvals/{approval}/approve": {
      "post": {
        "tags": [
          "agent-runs"
        ],
        "summary": "Approve the action the run waits on: it runs exactly as requested, and its hosts open for a while.",
        "operationId": "approve_agent_run_action",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "description": "Agent run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "approval",
            "in": "path",
            "description": "Approval request id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Not pending, or already decided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/agent-runs/{run}/approvals/{approval}/reject": {
      "post": {
        "tags": [
          "agent-runs"
        ],
        "summary": "Reject the action the run waits on; the run ends.",
        "operationId": "reject_agent_run_action",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "description": "Agent run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "approval",
            "in": "path",
            "description": "Approval request id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Not pending, or already decided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/agent-runs/{run}/cancel": {
      "post": {
        "tags": [
          "agent-runs"
        ],
        "summary": "Cancel an agent run. The run stops as soon as its harness hears it.",
        "operationId": "cancel_agent_run",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "description": "Agent run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The run has ended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/agent-runs/{run}/events": {
      "get": {
        "tags": [
          "agent-runs"
        ],
        "summary": "The run's harness events: plan, messages, tool calls, file changes, commands, approval requests and the result.",
        "operationId": "list_agent_run_events",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "description": "Agent run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalOut": {
        "type": "object",
        "required": [
          "id",
          "action",
          "title",
          "tool",
          "input",
          "requested_at"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The action on the approval list, e.g. `deploy`."
          },
          "decision": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DecisionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "requested_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "description": "The tool and its full input, exactly as they run if approved."
          }
        }
      },
      "Budget": {
        "type": "object",
        "description": "A project's agent budget across all its runs: harness time and model spend.",
        "required": [
          "minutes",
          "spend_usd_micros"
        ],
        "properties": {
          "minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "spend_usd_micros": {
            "type": "integer",
            "format": "int64",
            "description": "US dollars, in millionths.",
            "minimum": 0
          }
        }
      },
      "BudgetOut": {
        "type": "object",
        "required": [
          "budget",
          "used"
        ],
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "used": {
            "$ref": "#/components/schemas/Spend"
          }
        }
      },
      "CreateRun": {
        "type": "object",
        "required": [
          "task",
          "repository"
        ],
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "task": {
            "type": "string",
            "description": "What the agent should do. Up to 64 KiB."
          }
        }
      },
      "DecisionOut": {
        "type": "object",
        "required": [
          "outcome",
          "by",
          "at"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "description": "`approved` or `rejected`."
          }
        }
      },
      "Delivery": {
        "oneOf": [
          {
            "type": "object",
            "description": "The run ended before there was anything to deliver.",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "none"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The agent changed nothing.",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "no_changes"
                ]
              }
            }
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/PullRequest"
              },
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pull_request"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "description": "The branch or the pull request could not be made.",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            }
          }
        ],
        "description": "What became of a finished run's work."
      },
      "ErrorBody": {
        "type": "object",
        "description": "A short machine-readable code, as `oryxa-fde-api` answers.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "EventsOut": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "The run's harness events, in order (see `sandbox/harness/README.md`)."
          }
        }
      },
      "PullRequest": {
        "type": "object",
        "description": "The pull request a run opened.",
        "required": [
          "number",
          "url"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Repository": {
        "type": "object",
        "description": "A GitHub repository and the branch a run starts from. Every part reaches a command line, so each is checked.",
        "required": [
          "owner",
          "name",
          "base"
        ],
        "properties": {
          "base": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      },
      "RunOut": {
        "type": "object",
        "required": [
          "id",
          "state",
          "task",
          "repository",
          "created_by",
          "created_at",
          "usage",
          "delivery"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string",
            "description": "WorkOS user id."
          },
          "delivery": {
            "$ref": "#/components/schemas/Delivery"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why a `failed` run failed, e.g. `approval_rejected`, `cancelled`, `timed_out`, `over_budget`."
          },
          "id": {
            "type": "string"
          },
          "pending_approval": {
            "type": [
              "string",
              "null"
            ],
            "description": "The approval the run waits for, while `waiting_for_approval`."
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "description": "`queued`, `running`, `waiting_for_approval`, `finished` or `failed`."
          },
          "task": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageOut"
          }
        }
      },
      "Spend": {
        "type": "object",
        "description": "What a project's runs have used.",
        "required": [
          "seconds",
          "usd_micros"
        ],
        "properties": {
          "seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "usd_micros": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "UsageOut": {
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "properties": {
          "input_tokens": {
