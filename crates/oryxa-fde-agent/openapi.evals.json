{
  "openapi": "3.1.0",
  "info": {
    "title": "oryxa-fde-api: evals",
    "description": "Eval suites, runs and criterion pass rates. Served by oryxa-fde-api.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/companies/{company}/projects/{project}/eval-criteria": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "Each success criterion's pass rate, from the latest finished run of every suite that measures it. Readable by\nthe customer's guests on the project.",
        "operationId": "list_eval_criteria",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CriterionOut"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/eval-runs": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "The project's eval runs, newest first.",
        "operationId": "list_eval_runs",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvalRunOut"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/eval-runs/{run}": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "One eval run with its results per case and per criterion.",
        "operationId": "get_eval_run",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "description": "Eval run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvalRunOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/eval-suites": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "The project's eval suites, newest first.",
        "operationId": "list_eval_suites",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SuiteOut"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "evals"
        ],
        "summary": "Create an eval suite measuring some of the project's success criteria.",
        "operationId": "create_eval_suite",
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "description": "Company id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuiteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuiteOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{company}/projects/{project}/eval-suites/{suite}": {
      "get": {
        "tags": [
