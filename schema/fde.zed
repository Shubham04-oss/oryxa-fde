// FDE SpiceDB schema v1 (ADR 0002), down to sign-in (#296). Every object id is "<tenant>|<id>" (see
// oryxa-authz ids.rs), so tenants never share objects; the workspace object is the tenant root.
// user and workspace are copied from the platform's schema/oryxa.zed; keep them in step. The API mirrors
// each token's WorkOS role onto the workspace: admin or member, never both, and neither for anyone else.

definition user {}

definition workspace {
    relation admin: user
    relation member: user

    permission manage = admin
    permission access = admin + member
}
