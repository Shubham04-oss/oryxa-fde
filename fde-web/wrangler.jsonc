{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development only. Deployment and the route come with the infra stream: do not run
  // `wrangler deploy`.
  "name": "oryxa-fde-web",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Serves the app, forwards /api/* and /auth/* to the FDE API, and sets the security headers on
  // every answer. Static assets get theirs from public/_headers.
  "main": "src/server.ts",
  "vars": {
    // `pnpm dev` against a local oryxa-fde-api. A production build ignores it: there the Worker
    // reaches the API only through an `API` binding in `vpc_services` (infra `api_vpc_service_id`).
    "API_URL": "http://localhost:8080",
  },
  // Live run output (src/live.ts): the realtime Worker, reached only through this binding. Its token is
  // the secret REALTIME_SUBSCRIBE_TOKEN (`wrangler secret put`), never here.
  "services": [{ "binding": "REALTIME", "service": "oryxa-fde-realtime" }],
  "observability": { "enabled": true },
}
